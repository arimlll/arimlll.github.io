---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection, render } from 'astro:content';
import { getTagGroup } from '@/i18n/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const postsWithWordCount = await Promise.all(
    posts.map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      return {
        ...post,
        wordCount: remarkPluginFrontmatter?.wordCount,
      };
    })
  );

  // Group all posts by canonical group ID
  const groupMap = new Map<string, { group: any; posts: any[] }>();

  postsWithWordCount.forEach(post => {
    const postTags: string[] = post.data?.tags || [];
    postTags.forEach(tag => {
      const group = getTagGroup(tag);
      if (!groupMap.has(group.id)) {
        groupMap.set(group.id, { group, posts: [] });
      }
      const entry = groupMap.get(group.id)!;
      if (!entry.posts.some(p => (p.slug || p.id) === (post.slug || post.id))) {
        entry.posts.push(post);
      }
    });
  });

  const paths: any[] = [];
  groupMap.forEach(({ group, posts }) => {
    const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    const aliases = Array.from(new Set([group.zh, group.en, group.ja]));
    aliases.forEach(alias => {
      paths.push({
        params: { tag: alias },
        props: {
          tag: alias,
          group,
          posts: sortedPosts,
        },
      });
    });
  });

  return paths;
}

const { tag, group, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`标签「${tag}」下的所有博客文章`}>
  <div class="page-header" data-tag-group={group.id} data-tag-zh={group.zh} data-tag-en={group.en} data-tag-ja={group.ja}>
    <div class="breadcrumb">
      <a href="/tags/" data-i18n="tags.backToTags">&larr; 返回标签列表</a>
    </div>
    <h1 class="page-title" id="tag-page-title">#{tag}</h1>
    <p class="page-desc"><span data-i18n="tags.tagged">标签为</span> <span id="tag-desc-name">#{tag}</span></p>
  </div>

  <div class="post-list">
    {posts.map((post: any) => (
      <PostCard
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate.toISOString()}
        slug={post.slug || post.id}
        tags={post.data.tags}
        wordCount={post.wordCount}
        lang={post.data.lang}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-text);
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
  }

  .page-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
