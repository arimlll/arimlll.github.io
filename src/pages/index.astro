---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection, render } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const postsWithWordCount = await Promise.all(
  posts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 5)
    .map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      return {
        ...post,
        wordCount: remarkPluginFrontmatter?.wordCount,
      };
    })
);
---
<BaseLayout title="首页">
  <section class="hero animate-fade-in">
    <div class="hero-badge">Welcome</div>
    <h1 class="hero-title">Ariml<span class="hero-dot">.</span></h1>
    <p class="hero-quote">「黄河长江不会倒流」</p>
    <p class="hero-sub">微信公众号 <a href="https://mp.weixin.qq.com" target="_blank" rel="noopener" class="hero-link">@啊睿猫</a> · 法律与生活思考</p>
    <div class="hero-extra-links">
      <span>更多站点：</span>
      <a href="/jkfz187/" class="hero-chip">jkfz187</a>
      <a href="/jkfz187/czp/" class="hero-chip">一些蠢小说</a>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="recent-posts">
      <div class="section-header">
        <h2 class="section-title">最新文章</h2>
        <a href="/blog/" class="view-all-link">全部文章 ({posts.length}) &rarr;</a>
      </div>
      <div class="post-list">
        {postsWithWordCount.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate.toISOString()}
            slug={post.slug || post.id}
            tags={post.data.tags}
            wordCount={post.wordCount}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3.5rem 0 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.2rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-tag-text);
    background-color: var(--color-tag-bg);
    border-radius: 999px;
    margin-bottom: 1rem;
    border: 1px solid var(--color-border);
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
    line-height: 1.1;
  }

  .hero-dot {
    color: var(--color-accent);
  }

  .hero-quote {
    color: var(--color-text);
    font-size: 1.15rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .hero-sub {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .hero-link {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-extra-links {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-chip {
    display: inline-block;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.65rem;
    border-radius: 6px;
    color: var(--color-text);
    font-size: 0.85rem;
    transition: all 0.2s;
  }

  .hero-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-text);
    transform: translateY(-1px);
  }

  .recent-posts {
    margin-top: 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .section-title {
    font-size: 1.3rem;
    font-weight: 700;
    position: relative;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -0.55rem;
    left: 0;
    width: 2rem;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 2px;
  }

  .view-all-link {
    font-size: 0.85rem;
    color: var(--color-accent-text);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .view-all-link:hover {
    opacity: 0.8;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
