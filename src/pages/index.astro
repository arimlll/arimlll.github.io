---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection, render } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const postsWithWordCount = await Promise.all(
  posts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 5)
    .map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);
      return {
        ...post,
        wordCount: remarkPluginFrontmatter?.wordCount,
      };
    })
);
---
<BaseLayout title="首页">
  <section class="hero animate-fade-in">
    <h1 class="hero-title" id="hero-title">Ariml<span class="hero-dot">.</span></h1>
    <p class="hero-sub">微信公众号 <a href="https://mp.weixin.qq.com" target="_blank" rel="noopener" class="hero-link">@啊睿猫</a> ·「黄河长江不会倒流」</p>
  </section>

  {posts.length > 0 && (
    <section class="recent-posts">
      <div class="section-header">
        <h2 class="section-title" data-i18n="home.recentPosts">最新文章</h2>
        <a href="/blog/" class="view-all-link"><span data-i18n="home.viewAll">全部文章</span> ({posts.length}) &rarr;</a>
      </div>
      <div class="post-list">
        {postsWithWordCount.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate.toISOString()}
            slug={post.slug || post.id}
            tags={post.data.tags}
            wordCount={post.wordCount}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    line-height: 1.1;
    position: relative;
  }

  .hero-dot {
    color: var(--color-accent);
    text-shadow: 0 0 20px rgba(248, 200, 34, 0.4);
  }

  .hero-sub {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.04);
    display: inline-block;
  }

  .hero-link {
    color: var(--color-accent-text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .hero-link:hover {
    color: var(--color-accent-hover);
  }

  .recent-posts {
    margin-top: 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .section-title {
    font-size: 1.3rem;
    font-weight: 700;
    position: relative;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -0.55rem;
    left: 0;
    width: 2rem;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 2px;
  }

  .view-all-link {
    font-size: 0.85rem;
    color: var(--color-accent-text);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .view-all-link:hover {
    opacity: 0.8;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
