---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection, render } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const postsWithWordCount = await Promise.all(
  sortedPosts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return {
      ...post,
      wordCount: remarkPluginFrontmatter?.wordCount,
      readingTime: remarkPluginFrontmatter?.readingTime,
    };
  })
);
---
<BaseLayout title="首页">
  <section class="hero" id="home-hero">
    <div class="hero-content">
      <h1 class="hero-title" id="hero-title" aria-label="Ariml.">
        <span
          class="typewriter-text"
          id="typewriter-title"
          contenteditable="false"
          spellcheck="false"
          role="textbox"
          aria-multiline="false"
          data-placeholder="Ariml"
        >Ariml</span><span class="typewriter-cursor" id="typewriter-cursor" aria-hidden="true"></span><span class="hero-dot" id="hero-dot">.</span>
      </h1>
      <div class="typing-hint" id="typing-hint" aria-hidden="true">
        <span data-i18n="home.typeHint">点击或直接敲键盘即可打字</span>
      </div>
      <div class="hero-badge" id="hero-badge">
        <p class="hero-sub" data-i18n-html="home.subHtml">
          微信公众号 <a href="https://mp.weixin.qq.com" target="_blank" rel="noopener" class="hero-link">@啊睿猫</a> ·「黄河长江不会倒流」
        </p>
      </div>
    </div>

    <div class="hero-scroll-cue" id="hero-scroll-cue">
      <a href="#recent-posts" class="scroll-cue-btn" id="scroll-cue-btn" aria-label="向下滚动查看最新文章">
        <span class="scroll-cue-text" data-i18n="home.scrollDown">向下滚动查看</span>
        <svg class="scroll-cue-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="recent-posts" id="recent-posts">
      <div class="section-header">
        <h2 class="section-title" data-i18n="home.recentPosts">最新文章</h2>
        <a href="/blog/" class="view-all-link"><span data-i18n="home.viewAll">全部文章</span> &rarr;</a>
      </div>
      <div class="post-list">
        {postsWithWordCount.map(post => (
          <PostCard
            title={post.data.title}
            titleRuby={post.data.titleRuby}
            description={post.data.description}
            pubDate={post.data.pubDate.toISOString()}
            slug={post.slug || post.id}
            tags={post.data.tags}
            wordCount={post.wordCount}
            readingTime={post.readingTime}
            lang={post.data.lang}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  let typingTimeoutId: number | null = null;
  let hintTimeoutId: number | null = null;

  function initHomeHero() {
    if (typingTimeoutId) clearTimeout(typingTimeoutId);
    if (hintTimeoutId) clearTimeout(hintTimeoutId);

    const titleEl = document.getElementById('typewriter-title');
    const dotEl = document.getElementById('hero-dot');
    const cursorEl = document.getElementById('typewriter-cursor');
    const hintEl = document.getElementById('typing-hint');
    const badgeEl = document.getElementById('hero-badge');
    const scrollCueEl = document.getElementById('hero-scroll-cue');
    const recentPostsEl = document.getElementById('recent-posts');
    const cueBtn = document.getElementById('scroll-cue-btn');

    if (!titleEl || !dotEl || !cursorEl) return;

    if (cueBtn && !cueBtn.dataset.bound) {
      cueBtn.dataset.bound = 'true';
      cueBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById('recent-posts');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    function enableInteractiveTyping() {
      if (!titleEl) return;
      titleEl.setAttribute('contenteditable', 'true');

      if (!titleEl.dataset.eventsBound) {
        titleEl.dataset.eventsBound = 'true';

        // IME-safe enter handling
        titleEl.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            if (e.isComposing || e.keyCode === 229) return;
            titleEl.blur();
          }
        });

        // Hide hint on focus
        titleEl.addEventListener('focus', () => {
          if (hintEl) hintEl.classList.remove('revealed');
        });

        // If user presses printable keys while at top of page, focus titleEl
        window.addEventListener('keydown', (e: KeyboardEvent) => {
          if (titleEl.getAttribute('contenteditable') !== 'true') return;
          if (document.activeElement === titleEl) return;
          if (window.scrollY > 120) return;

          const target = e.target as HTMLElement;
          if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) {
            return;
          }

          if (e.ctrlKey || e.metaKey || e.altKey) return;
          if (e.key.length === 1 || e.key === 'Backspace') {
            titleEl.focus();
            const selection = window.getSelection();
            const range = document.createRange();
            range.selectNodeContents(titleEl);
            range.collapse(false);
            if (selection) {
              selection.removeAllRanges();
              selection.addRange(range);
            }
          }
        });
      }
    }

    // Respect prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      titleEl.textContent = 'Ariml';
      dotEl.classList.add('lit');
      cursorEl.style.display = 'none';
      if (badgeEl) badgeEl.classList.add('revealed');
      if (scrollCueEl) scrollCueEl.classList.add('revealed');
      if (recentPostsEl) recentPostsEl.classList.add('revealed');
      enableInteractiveTyping();
      return;
    }

    const titleBase = 'Ariml';

    // Reset initial typing state
    titleEl.textContent = '';
    titleEl.setAttribute('contenteditable', 'false');
    dotEl.classList.remove('lit');
    cursorEl.classList.remove('cursor-finished');
    cursorEl.style.display = 'inline-block';
    if (hintEl) hintEl.classList.remove('revealed');
    if (badgeEl) badgeEl.classList.remove('revealed');
    if (scrollCueEl) scrollCueEl.classList.remove('revealed');
    if (recentPostsEl) recentPostsEl.classList.remove('revealed');

    let titleIndex = 0;
    function typeTitle() {
      if (titleIndex < titleBase.length) {
        titleEl.textContent = titleBase.slice(0, titleIndex + 1);
        titleIndex++;
        typingTimeoutId = window.setTimeout(typeTitle, 80 + Math.random() * 35);
      } else {
        finishTyping();
      }
    }

    function finishTyping() {
      cursorEl.classList.add('cursor-finished');
      cursorEl.style.display = 'none';

      // Light up the iconic golden dot!
      dotEl.classList.add('lit');

      // Enable real interactive typing!
      enableInteractiveTyping();

      // Show typing hint briefly (3.5s)
      if (hintEl) {
        hintEl.classList.add('revealed');
        hintTimeoutId = window.setTimeout(() => {
          hintEl.classList.remove('revealed');
        }, 3500);
      }

      // Smoothly fade in the capsule badge, scroll down cue, and content below
      if (badgeEl) badgeEl.classList.add('revealed');
      if (scrollCueEl) scrollCueEl.classList.add('revealed');
      if (recentPostsEl) recentPostsEl.classList.add('revealed');
    }

    typingTimeoutId = window.setTimeout(typeTitle, 180);
  }

  initHomeHero();
  document.addEventListener('astro:after-swap', initHomeHero);
</script>

<style>
  .hero {
    position: relative;
    text-align: center;
    min-height: calc(100vh - var(--header-height));
    min-height: calc(100dvh - var(--header-height));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1rem 3.5rem;
    box-sizing: border-box;
    overflow: visible;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: -1.75rem;
    overflow: visible;
    width: 100%;
    max-width: 100%;
  }

  .hero-title {
    font-size: clamp(3.2rem, 7.5vw, 5.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-bottom: 0.6rem;
    line-height: 1.25;
    position: relative;
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    overflow: visible;
    padding: 0.2rem 0.6rem;
  }

  .typewriter-text {
    outline: none;
    cursor: text;
    user-select: text;
    -webkit-user-select: text;
    white-space: pre-wrap;
    word-break: break-word;
    caret-color: var(--color-accent);
    min-width: 1ch;
    border-radius: 8px;
    padding: 0 0.08em;
    transition: background-color 0.2s ease;
  }

  .typewriter-text[contenteditable="true"]:hover {
    background-color: rgba(248, 200, 34, 0.08);
  }

  .typewriter-text[contenteditable="true"]:focus {
    background-color: rgba(248, 200, 34, 0.1);
  }

  .typewriter-text:empty::before {
    content: attr(data-placeholder);
    color: var(--color-text-secondary);
    opacity: 0.35;
  }

  .typewriter-cursor {
    display: inline-block;
    width: 2.5px;
    height: 1.15em;
    vertical-align: -0.15em;
    background-color: var(--color-accent);
    margin-left: 2px;
    margin-right: 2px;
    animation: cursorBlink 0.75s step-end infinite;
    box-shadow: 0 0 8px rgba(248, 200, 34, 0.6);
    border-radius: 1px;
    transition: opacity 0.4s ease-out;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .typewriter-cursor.cursor-finished {
    opacity: 0;
  }

  /* Golden dot - pure multi-layer text-shadow for unclipped radiant aura */
  .hero-dot {
    color: var(--color-accent);
    opacity: 0;
    transform: scale(0.4);
    display: inline-block;
    vertical-align: baseline;
    padding: 0 0.15em;
    margin-right: -0.1em;
    overflow: visible;
    transition: opacity 0.35s ease-out, transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), text-shadow 0.35s ease;
  }

  .hero-dot.lit {
    opacity: 1;
    transform: scale(1);
    text-shadow:
      0 0 10px rgba(248, 200, 34, 1),
      0 0 24px rgba(248, 200, 34, 0.85),
      0 0 48px rgba(248, 200, 34, 0.6),
      0 0 75px rgba(248, 200, 34, 0.35);
    animation: dotPulse 3s ease-in-out infinite alternate;
  }

  @keyframes dotPulse {
    0% {
      text-shadow:
        0 0 10px rgba(248, 200, 34, 1),
        0 0 22px rgba(248, 200, 34, 0.8),
        0 0 42px rgba(248, 200, 34, 0.55),
        0 0 65px rgba(248, 200, 34, 0.3);
    }
    100% {
      text-shadow:
        0 0 14px rgba(248, 200, 34, 1),
        0 0 30px rgba(248, 200, 34, 0.95),
        0 0 58px rgba(248, 200, 34, 0.7),
        0 0 90px rgba(248, 200, 34, 0.45);
    }
  }

  /* Interactive typing tooltip hint */
  .typing-hint {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-accent-text);
    background-color: var(--color-tag-bg);
    border: 1px solid var(--color-tag-border);
    padding: 0.22rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 0.85rem;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }

  .typing-hint.revealed {
    opacity: 0.92;
    transform: translateY(0);
  }

  .hero-badge {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-badge.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-sub {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    padding: 0.45rem 1.35rem;
    border-radius: 9999px;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 2px 10px -2px rgba(0, 0, 0, 0.05);
    display: inline-block;
    line-height: 1.5;
  }

  .hero-link {
    color: var(--color-accent-text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .hero-link:hover {
    color: var(--color-accent-hover);
  }

  .hero-scroll-cue {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
  }

  .hero-scroll-cue.revealed {
    opacity: 0.85;
  }

  .hero-scroll-cue:hover {
    opacity: 1;
  }

  .scroll-cue-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.2s ease;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
  }

  .scroll-cue-btn:hover {
    color: var(--color-accent-text);
  }

  .scroll-cue-icon {
    animation: floatDown 2s ease-in-out infinite;
  }

  @keyframes floatDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  .recent-posts {
    margin-top: 1rem;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .recent-posts.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge,
    .hero-scroll-cue,
    .recent-posts,
    .hero-dot {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      transition: none !important;
    }
    .typewriter-cursor {
      display: none !important;
    }
    .scroll-cue-icon {
      animation: none !important;
    }
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .section-title {
    font-size: 1.3rem;
    font-weight: 700;
    position: relative;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -0.55rem;
    left: 0;
    width: 2rem;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 2px;
  }

  .view-all-link {
    font-size: 0.85rem;
    color: var(--color-accent-text);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .view-all-link:hover {
    opacity: 0.8;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
