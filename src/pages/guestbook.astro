---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';
---
<BaseLayout title="留言墙" description="雁过留痕，风过留声。欢迎在留言墙留下你的想法与足迹。">
  <div class="page-header animate-fade-in">
    <h1 class="page-title">留言墙</h1>
    <p class="page-desc">雁过留痕，风过留声。欢迎在此畅所欲言、交流讨论。</p>
  </div>

  <Giscus isGuestbook={true} />
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
  }

  .page-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }
</style>
