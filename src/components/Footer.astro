---
const year = new Date().getFullYear();
const siteUrl = 'https://arimlll.github.io';
---
<!-- Toast Notification -->
<div id="footer-toast" class="toast">
  <span id="footer-toast-message"></span>
</div>

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-left">
      <p class="footer-meta">
        &copy; {year} Ariml. <a href="https://www.gnu.org/licenses/agpl-3.0.html" target="_blank" rel="noopener" class="license-link">AGPL 3.0</a>
        <span class="sep">·</span>
        <a href="/jkfz187/" class="footer-site-link">jkfz187</a>
        <span class="sep">·</span>
        <a href="/jkfz187/czp/" class="footer-site-link">一些蠢小说</a>
      </p>
    </div>
    <div class="footer-links">
      <button class="footer-link rss-btn" id="rss-btn" data-rss={`${siteUrl}/rss.xml`} aria-label="复制 RSS 订阅地址" title="点击复制 RSS 订阅地址">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span>RSS</span>
      </button>
      <a href="https://github.com/arimlll" target="_blank" rel="noopener" class="footer-link" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 2.25rem 0;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    margin-top: 3.5rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
  }

  .footer-meta {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0;
  }

  .footer-site-link {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .footer-site-link:hover {
    color: var(--color-accent-text);
  }

  .sep {
    opacity: 0.45;
  }

  .license-link {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .license-link:hover {
    color: var(--color-accent-text);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-secondary);
    transition: color 0.2s;
    text-decoration: none;
    font-size: 0.85rem;
  }

  .footer-link:hover {
    color: var(--color-accent-text);
  }

  .rss-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
  }

  .toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background-color: var(--color-card-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1000;
    pointer-events: none;
  }

  .toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
</style>

<script>
  function showFooterToast(message: string) {
    const toast = document.getElementById('footer-toast');
    const toastMessage = document.getElementById('footer-toast-message');
    if (!toast || !toastMessage) return;
    
    toastMessage.textContent = message;
    toast.classList.add('show');
    
    setTimeout(() => {
      toast.classList.remove('show');
    }, 2500);
  }

  function initRssButton() {
    const btn = document.getElementById('rss-btn');
    if (!btn) return;
    
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const rssUrl = btn.getAttribute('data-rss');
      if (!rssUrl) return;
      
      try {
        await navigator.clipboard.writeText(rssUrl);
        showFooterToast('RSS 订阅地址已复制');
      } catch (err) {
        const textarea = document.createElement('textarea');
        textarea.value = rssUrl;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        showFooterToast('RSS 订阅地址已复制');
      }
    });
  }
  
  initRssButton();
  document.addEventListener('astro:after-swap', initRssButton);
</script>
