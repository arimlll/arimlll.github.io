---
const year = new Date().getFullYear();
const siteUrl = 'https://arimlll.github.io';
---
<!-- Toast Notification -->
<div id="footer-toast" class="toast">
  <span id="footer-toast-message"></span>
</div>

<footer class="footer">
  <div class="footer-inner container">
    <p>&copy; {year} Ariml. <a href="https://www.gnu.org/licenses/agpl-3.0.html" target="_blank" rel="noopener" class="license-link">AGPL 3.0</a></p>
    <div class="footer-links">
      <div class="rss-wrapper">
        <a href="/rss.xml" target="_blank" class="footer-link rss-link" aria-label="RSS 订阅源" title="查看 RSS 订阅源">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          RSS
        </a>
        <button class="rss-copy-btn" id="rss-copy-btn" aria-label="复制 RSS 订阅地址" title="复制 RSS 地址" data-rss={`${siteUrl}/rss.xml`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
      <a href="https://github.com/arimlll" target="_blank" rel="noopener" class="footer-link" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
        GitHub
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    margin-top: 3rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .license-link {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .license-link:hover {
    color: var(--color-accent-text);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-secondary);
    transition: color 0.2s;
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--color-accent-text);
  }

  .rss-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .rss-copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 2px 4px;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s;
  }

  .rss-copy-btn:hover {
    color: var(--color-accent-text);
    border-color: var(--color-accent);
  }

  .toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background-color: var(--color-card-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1000;
    pointer-events: none;
  }

  .toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
</style>

<script>
  function showFooterToast(message: string) {
    const toast = document.getElementById('footer-toast');
    const toastMessage = document.getElementById('footer-toast-message');
    if (!toast || !toastMessage) return;
    
    toastMessage.textContent = message;
    toast.classList.add('show');
    
    setTimeout(() => {
      toast.classList.remove('show');
    }, 2500);
  }

  function initRssCopyButton() {
    const btn = document.getElementById('rss-copy-btn');
    if (!btn) return;
    
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const rssUrl = btn.getAttribute('data-rss');
      if (!rssUrl) return;
      
      try {
        await navigator.clipboard.writeText(rssUrl);
        showFooterToast('RSS 订阅地址已复制');
      } catch (err) {
        const textarea = document.createElement('textarea');
        textarea.value = rssUrl;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        showFooterToast('RSS 订阅地址已复制');
      }
    });
  }
  
  initRssCopyButton();
  document.addEventListener('astro:after-swap', initRssCopyButton);
</script>
