---
import { WALINE_CONFIG } from '@/config';

interface Props {
  serverURL?: string;
  path?: string;
  isGuestbook?: boolean;
}

const {
  serverURL = WALINE_CONFIG.serverURL,
  path = Astro.url.pathname,
  isGuestbook = false,
} = Astro.props;
---
<div class="waline-container">
  {serverURL ? (
    <div id="waline" data-server-url={serverURL} data-path={path}></div>
  ) : (
    <div class="waline-setup-card">
      <div class="setup-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
      <h3>{isGuestbook ? '留言墙' : '评论区'}已切换为 Waline（支持免登录）</h3>
      <p>前端组件已全面配置就绪，访客无需任何账号登录即可畅所欲言。请在配置文件中填入您的 Waline 服务端地址以激活数据读写：</p>
      
      <div class="setup-steps">
        <div class="step-item">
          <span class="step-num">1</span>
          <div>
            <strong>一键免费部署 Waline 后端（约需 1 分钟）</strong>
            <p>前往 <a href="https://waline.js.org/guide/get-started/" target="_blank" rel="noopener">Waline 快速部署指引</a>，点击 <strong>Vercel 一键部署</strong>（数据库推荐使用免费的 LeanCloud 或 Supabase）。</p>
          </div>
        </div>
        <div class="step-item">
          <span class="step-num">2</span>
          <div>
            <strong>在 <code>src/config.ts</code> 填入地址</strong>
            <p>将部署后获得的独立域名填入 <code>src/config.ts</code> 的 <code>WALINE_CONFIG.serverURL</code> 中（例如 <code>https://waline.yourdomain.com</code>），文章评论与留言墙即可全站一键激活。</p>
          </div>
        </div>
      </div>
      <p class="setup-tip">💡 如果您已有部署好的地址，可以直接告诉我，我来为您一键填入生效！</p>
    </div>
  )}
</div>

{serverURL && (
  <script>
    import { init } from '@waline/client';
    import '@waline/client/style';

    function setupWaline() {
      const el = document.getElementById('waline');
      if (!el) return;
      const serverURL = el.getAttribute('data-server-url');
      if (!serverURL) return;

      init({
        el: '#waline',
        serverURL,
        path: el.getAttribute('data-path') || window.location.pathname,
        dark: 'html[data-theme="dark"]',
        search: false,
        reaction: true,
        meta: ['nick', 'mail', 'link'],
        requiredMeta: ['nick'], // 仅需输入昵称，任何人均可免登录直接发表
        login: 'disable', // 禁用强制登录
        emoji: [
          '//unpkg.com/@waline/emojis@1.2.0/weibo',
          '//unpkg.com/@waline/emojis@1.2.0/bilibili',
        ],
        locale: {
          placeholder: '雁过留痕，风过留声（无需登录，输入昵称即可发布）...',
        },
      });
    }

    setupWaline();
    document.addEventListener('astro:after-swap', setupWaline);
  </script>
)}

<style is:global>
  /* Waline 自定义色彩与布局适配 */
  :root {
    --waline-theme-color: var(--color-accent-text);
    --waline-active-color: var(--color-accent-hover);
    --waline-color: var(--color-text);
    --waline-bg-color: var(--color-card-bg);
    --waline-bg-color-light: var(--color-bg);
    --waline-border-color: var(--color-border);
    --waline-disable-bg-color: var(--color-code-bg);
    --waline-disable-color: var(--color-text-secondary);
    --waline-code-bg-color: var(--color-code-bg);
    --waline-bq-color: var(--color-card-bg);
    --waline-avatar-radius: 8px;
    --waline-badge-color: var(--color-accent-text);
    --waline-badge-border-color: var(--color-accent);
    --waline-info-bg-color: var(--color-bg);
    --waline-info-color: var(--color-text-secondary);
    --waline-border: 1px solid var(--color-border);
    --waline-font-size: 0.95rem;
  }

  [data-theme="dark"] {
    --waline-theme-color: var(--color-accent);
    --waline-active-color: var(--color-accent-hover);
    --waline-color: var(--color-text);
    --waline-bg-color: var(--color-card-bg);
    --waline-bg-color-light: var(--color-bg);
    --waline-border-color: var(--color-border);
    --waline-disable-bg-color: var(--color-code-bg);
    --waline-disable-color: var(--color-text-secondary);
    --waline-code-bg-color: var(--color-code-bg);
    --waline-bq-color: var(--color-card-bg);
    --waline-badge-color: var(--color-accent);
    --waline-badge-border-color: var(--color-accent);
    --waline-info-bg-color: var(--color-bg);
    --waline-info-color: var(--color-text-secondary);
  }

  .wl-panel {
    border-radius: 12px !important;
    border: 1px solid var(--color-border) !important;
    background-color: var(--color-card-bg) !important;
  }

  .wl-btn {
    border-radius: 6px !important;
  }

  .wl-btn.primary {
    background-color: var(--color-accent) !important;
    color: #1a1a1a !important;
    border-color: var(--color-accent) !important;
    font-weight: 600;
  }

  .wl-card-item {
    border-bottom: 1px dashed var(--color-border) !important;
  }
</style>

<style>
  .waline-container {
    margin-top: 2rem;
  }

  .waline-setup-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 2rem;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
  }

  .setup-icon {
    display: inline-flex;
    padding: 0.75rem;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: 12px;
    margin-bottom: 1rem;
  }

  .waline-setup-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
  }

  .waline-setup-card > p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .setup-steps {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .step-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: #1a1a1a;
    font-size: 0.85rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .step-item strong {
    font-size: 0.95rem;
    display: block;
    margin-bottom: 0.25rem;
  }

  .step-item p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .step-item a {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .setup-tip {
    font-size: 0.88rem;
    color: var(--color-accent-text);
    background-color: var(--color-tag-bg);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }
</style>
