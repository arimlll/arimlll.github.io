---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitch from './LanguageSwitch.astro';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: '首页', key: 'nav.home' },
  { href: '/blog/', label: '博客', key: 'nav.blog' },
  { href: '/tags/', label: '标签', key: 'nav.tags' },
  { href: '/guestbook/', label: '留言', key: 'nav.guestbook' },
  { href: '/search/', label: '搜索', key: 'nav.search' },
];

function isLinkActive(linkHref: string, path: string): boolean {
  if (linkHref === '/') return path === '/' || path === '';
  return path.startsWith(linkHref);
}

const isHomePage = currentPath === '/' || currentPath === '';
---
<header class="header">
  <nav class="header-inner" aria-label="主要导航">
    <div
      class:list={[
        'header-logo-container',
        { 'home-scroll-logo': isHomePage }
      ]}
      id="header-logo-container"
    >
      <Logo />
    </div>

    <div class="nav-links" id="nav-links">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { active: isLinkActive(link.href, currentPath) }]}
          data-i18n={link.key}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="header-actions">
      <LanguageSwitch />
      <ThemeToggle />
      <button class="menu-toggle" id="menu-toggle" aria-label="切换菜单" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  function initMenu() {
    const btn = document.getElementById('menu-toggle');
    const nav = document.getElementById('nav-links');
    if (!btn || !nav) return;

    function toggleMenu(open?: boolean) {
      const isOpen = open !== undefined ? open : !nav!.classList.contains('open');
      nav!.classList.toggle('open', isOpen);
      btn!.setAttribute('aria-expanded', String(isOpen));
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    document.addEventListener('click', (e) => {
      if (nav.classList.contains('open') && !nav.contains(e.target as Node) && e.target !== btn) {
        toggleMenu(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        toggleMenu(false);
      }
    });
  }

  function initHeaderLogoScroll() {
    const logoContainer = document.getElementById('header-logo-container');
    if (!logoContainer) return;

    const heroTitle = document.getElementById('hero-title');
    if (!heroTitle) {
      // Non-home page: always display logo
      logoContainer.classList.remove('home-scroll-logo');
      return;
    }

    const header = document.querySelector('.header');
    const headerHeight = header ? header.clientHeight : 60;

    function handleScroll() {
      const rect = heroTitle!.getBoundingClientRect();
      // When navbar reaches/covers Ariml title, reveal navbar logo
      if (rect.top <= headerHeight) {
        logoContainer!.classList.add('logo-revealed');
      } else {
        logoContainer!.classList.remove('logo-revealed');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', handleScroll, { passive: true });
    handleScroll();
  }

  initMenu();
  initHeaderLogoScroll();
  document.addEventListener('astro:after-swap', () => {
    initMenu();
    initHeaderLogoScroll();
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: var(--color-header-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-card-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    width: 100%;
    max-width: 100%;
    padding-left: clamp(1.25rem, 3.5vw, 2.75rem);
    padding-right: clamp(1.25rem, 3.5vw, 2.75rem);
  }

  .header-logo-container {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* When on home page, hide logo until Ariml header is covered by navbar */
  .header-logo-container.home-scroll-logo {
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
  }

  .header-logo-container.home-scroll-logo.logo-revealed {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav-links {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }

  .header-actions {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.85rem;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-card-bg);
    border-color: var(--color-card-border);
  }

  .nav-link.active {
    color: var(--color-text);
    font-weight: 600;
    background-color: var(--color-tag-bg);
    border: 1px solid var(--color-tag-border);
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    padding: 0.3rem;
    border-radius: 6px;
    transition: background 0.2s;
  }

  .menu-toggle:hover {
    background-color: var(--color-border);
  }

  @media (max-width: 640px) {
    .header-inner {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .header-logo-container {
      flex: 0 0 auto;
    }

    .header-actions {
      flex: 0 0 auto;
      gap: 0.5rem;
    }

    .menu-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      flex-direction: column;
      background-color: var(--color-header-bg);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      padding: 1.25rem 1.75rem;
      gap: 1rem;
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      align-items: flex-start;
    }

    .nav-links.open {
      display: flex;
      animation: fade-in 0.2s ease-out forwards;
    }

    .nav-link {
      font-size: 1.05rem;
      width: 100%;
    }

    .nav-link.active::after {
      display: none;
    }
  }
</style>
