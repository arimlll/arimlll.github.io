---
import { CUSDIS_CONFIG } from '@/config';

interface Props {
  pageId: string;
  pageTitle: string;
  pageUrl?: string;
  isGuestbook?: boolean;
  appId?: string;
  host?: string;
}

const {
  pageId,
  pageTitle,
  pageUrl = Astro.url.href,
  isGuestbook = false,
  appId = CUSDIS_CONFIG.appId,
  host = CUSDIS_CONFIG.host || 'https://cusdis.com',
} = Astro.props;
---

<div class="cusdis-container">
  {appId ? (
    <div
      id="cusdis_thread"
      data-host={host}
      data-app-id={appId}
      data-page-id={pageId}
      data-page-url={pageUrl}
      data-page-title={pageTitle}
      data-theme="auto"
    ></div>
  ) : (
    <div class="cusdis-setup-card">
      <div class="setup-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
      <h3>{isGuestbook ? '留言墙' : '评论区'}（Cusdis 免登录系统就绪）</h3>
      <p>无需云服务器、无需数据库、免绑信用卡。访客仅需输入昵称即可畅所欲言发表留言：</p>

      <div class="setup-steps">
        <div class="step-item">
          <span class="step-num">1</span>
          <div>
            <strong>登录 Cusdis 控制台（约 10 秒）</strong>
            <p>打开 <a href="https://cusdis.com" target="_blank" rel="noopener">Cusdis 官网 (cusdis.com)</a>，点击右上角直接用 <strong>GitHub 登录</strong>授权。</p>
          </div>
        </div>
        <div class="step-item">
          <span class="step-num">2</span>
          <div>
            <strong>点击 "Add App" 获取 APP ID</strong>
            <p>在控制台点击 <strong>Add App</strong> 按钮，输入博客名字（如 <code>Ariml Blog</code>），复制生成的 <code>APP ID</code>（一串类似 <code>d4f6a7b8-...</code> 的代码）。</p>
          </div>
        </div>
        <div class="step-item">
          <span class="step-num">3</span>
          <div>
            <strong>填入配置或发送给我</strong>
            <p>将获取到的 APP ID 填入 <code>src/config.ts</code> 的 <code>CUSDIS_CONFIG.appId</code> 中（或直接发给我），全站文章评论区与留言墙即可全量点亮！</p>
          </div>
        </div>
      </div>
      <p class="setup-tip">💡 只要把生成的 APP ID 复制发给我，我立刻为您填入生效！</p>
    </div>
  )}
</div>

{appId && (
  <script is:inline src="https://cusdis.com/js/cusdis.es.js" async defer></script>
  <script>
    function updateCusdisTheme() {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'auto';
      const thread = document.getElementById('cusdis_thread');
      if (thread) {
        thread.setAttribute('data-theme', currentTheme);
      }
      if ((window as any).CUSDIS && typeof (window as any).CUSDIS.setTheme === 'function') {
        (window as any).CUSDIS.setTheme(currentTheme);
      }
    }

    function initCusdis() {
      if ((window as any).CUSDIS && typeof (window as any).CUSDIS.initialTo === 'function') {
        (window as any).CUSDIS.initialTo();
      }
      updateCusdisTheme();
    }

    window.addEventListener('theme-change', (e: any) => {
      const theme = e.detail?.theme || 'auto';
      const thread = document.getElementById('cusdis_thread');
      if (thread) {
        thread.setAttribute('data-theme', theme);
      }
      if ((window as any).CUSDIS && typeof (window as any).CUSDIS.setTheme === 'function') {
        (window as any).CUSDIS.setTheme(theme);
      }
    });

    document.addEventListener('astro:after-swap', initCusdis);
  </script>
)}

<style>
  .cusdis-container {
    margin-top: 2rem;
  }

  .cusdis-setup-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 14px;
    padding: 2rem;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: var(--card-shadow);
  }

  .setup-icon {
    display: inline-flex;
    padding: 0.75rem;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: 12px;
    margin-bottom: 1rem;
    border: 1px solid var(--color-tag-border);
  }

  .cusdis-setup-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
  }

  .cusdis-setup-card > p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .setup-steps {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .step-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    min-width: 26px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: #1a1a1a;
    font-weight: 700;
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }

  .step-item strong {
    font-size: 0.95rem;
    display: block;
    margin-bottom: 0.25rem;
  }

  .step-item p {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .step-item a {
    color: var(--color-accent-text);
    font-weight: 600;
  }

  .setup-tip {
    font-size: 0.9rem;
    color: var(--color-accent-text);
    background-color: var(--color-tag-bg);
    border: 1px solid var(--color-tag-border);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    margin: 0;
  }
</style>
