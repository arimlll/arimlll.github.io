---
interface Props {
  title: string;
  description: string;
  pubDate: string;
  slug: string;
  tags?: string[];
  wordCount?: number;
  lang?: string;
}

const { title, description, pubDate, slug, tags = [], wordCount, lang = 'zh' } = Astro.props;
const date = new Date(pubDate);
const locale = lang === 'en' ? 'en-US' : lang === 'ja' ? 'ja-JP' : 'zh-CN';
const formattedDate = date.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const readingTime = wordCount ? Math.max(1, Math.ceil(wordCount / 300)) : null;

const wordsUnit = lang === 'en' ? 'words' : lang === 'ja' ? '文字' : '字';
const minText = lang === 'en' ? `~${readingTime} min` : lang === 'ja' ? `約 ${readingTime} 分` : `约 ${readingTime} 分钟`;
---
<article class="post-card" data-post-lang={lang}>
  <a href={`/blog/${slug}/`} class="post-card-link">
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-desc">{description}</p>
    <div class="post-card-meta">
      <time datetime={date.toISOString()} class="meta-date">{formattedDate}</time>
      {wordCount && (
        <span class="meta-stats">
          <span>{wordCount} {wordsUnit}</span>
          {readingTime && <span>· {minText}</span>}
        </span>
      )}
      {tags.length > 0 && (
        <div class="post-card-tags">
          {tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .post-card {
    border: 1px solid var(--color-card-border);
    border-radius: 14px;
    background-color: var(--color-card-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: var(--card-shadow);
    position: relative;
    overflow: hidden;
  }

  .post-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: var(--card-hover-shadow);
  }

  .post-card-link {
    display: block;
    padding: 1.4rem 1.65rem;
    text-decoration: none;
    color: inherit;
  }

  .post-card-title {
    font-size: 1.22rem;
    font-weight: 700;
    margin-bottom: 0.55rem;
    color: var(--color-text);
    transition: color 0.2s;
    line-height: 1.4;
  }

  .post-card:hover .post-card-title {
    color: var(--color-accent-text);
  }

  .post-card-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.9rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    flex-wrap: wrap;
  }

  .meta-date {
    color: var(--color-text-secondary);
  }

  .meta-stats {
    display: inline-flex;
    gap: 0.35rem;
  }

  .post-card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-left: auto;
  }

  .tag {
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    border: 1px solid var(--color-tag-border);
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .post-card:hover .tag {
    border-color: var(--color-accent);
  }
</style>
